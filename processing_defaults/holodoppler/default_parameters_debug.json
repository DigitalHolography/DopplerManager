{
    "pipeline_name": "main",
    "backend": "cupyRAM",
    "batch_size": 256,
    "batch_stride": 256,
    "accumulation": 1,
    "image_registration": true,
    "image_registration_type": "translation_rotation_scale",
    "registration_disc_ratio": 0.8,
    "registration_flatfield_gw": 35,
    "registration_gaussian_sigma": 0,
    "registration_integer_translation": false,
    "batch_size_registration": 512,
    "apply_registration": true,
    "first_frame": 0,
    "end_frame": -1,
    "wavelength": 8.52e-07,
    "pixel_pitch": [
        2e-05,
        2e-05
    ],
    "spatial_propagation": "Fresnel",
    "Fresnel_use_ouput_kernel": false,
    "zero_padding": false,
    "z": "use_holovibes",
    "shack_hartmann": false,
    "shack_hartmann_accumulation": 1,
    "shack_hartmann_svd_threshold": 10,
    "shack_hartmann_graph_ref": "central_sub_ap",
    "shack_hartmann_graph_laplacian": true,
    "shack_hartmann_ny_subap": 5,
    "shack_hartmann_nx_subap": 5,
    "shack_hartmann_pupil_threshold": 1.5,
    "shack_hartmann_deviation_threshold": 10.0,
    "shack_hartmann_shifts_pixel_range_threshold": 1000,
    "shack_hartmann_zernike_fit": true,
    "shack_hartmann_zernike_fit_modes": [
        4,
        5,
        6
    ],
    "shack_hartmann_southwell_phase_integration": false,
    "temporal_transformation": "FourierTransform",
    "sampling_freq": "use_holovibes",
    "low_freq": 6000,
    "high_freq": 18000,
    "frequency_bands": [
        [
            3000,
            9000
        ],
        [
            9000,
            18000
        ]
    ],
    "corner_compensation": false,
    "svd_threshold": 40,
    "svd_filter_mode": "number_of_values",
    "svd_remove_dc": false,
    "save_psd_avg": false,
    "square": true,
    "transpose": false,
    "flip_x": false,
    "flip_y": false,
    "debug": true,
    "tictoc": false,
    "contrast_adjustment": {
        "enabled": true,
        "low_percent": 0.2,
        "high_percent": 99.8,
        "gamma": 1.0
    },
    "debug_plot_parameters": {
        "spectrumloglog": {
            "ylim": [
                1.0,
                10.0
            ],
            "fit_f1": 2000,
            "fit_f2": 7000
        },
        "spectrum": {
            "ylim": [
                0,
                0.15
            ],
            "use_stem": false
        },
        "SVD_eigenvalues": {
            "ylim": [
                1,
                1e+25
            ],
            "log_plot": true
        },
        "shifts": {
            "scale": 30
        }
    }
}