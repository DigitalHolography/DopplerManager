{
  "pipeline_name" : "moments_main_pipeline",
  "backend": "cupy",
  "batch_size": 256,
  "batch_stride": 256,
  "accumulation": 1,
  "image_registration": true,
  "image_registration_type": "translation_rotation_scale",
  "registration_disc_ratio": 0.8,
  "registration_flatfield_gw": 35,
  "registration_gaussian_sigma": null,
  "registration_integer_translation": true,
  "batch_size_registration": 512,
  "apply_registration": true,
  "first_frame": 0,
  "end_frame": -1,
  "wavelength": 8.52e-7,
  "pixel_pitch": [2e-5,2e-5],
  "spatial_propagation": "Fresnel",
  "Fresnel_use_ouput_kernel": false,
  "zero_padding": false,
  "z": 1.25,
  "shack_hartmann": true,
  "shack_hartmann_accumulation": 1,
  "shack_hartmann_svd_threshold": 10,
  "shack_hartmann_graph_ref": "central_sub_ap",
  "shack_hartmann_graph_laplacian": true,
  "shack_hartmann_ny_subap": 5,
  "shack_hartmann_nx_subap": 5,
  "shack_hartmann_pupil_threshold": 2.0,
  "shack_hartmann_deviation_threshold": 1000.0,
  "shack_hartmann_shifts_pixel_range_threshold": 1000,
  "shack_hartmann_zernike_fit": true,
  "shack_hartmann_zernike_fit_modes": [4,5,6],
  "shack_hartmann_southwell_phase_integration": false,
  "temporal_transformation": "FourierTransform",
  "sampling_freq": 78000,
  "low_freq": 6000,
  "high_freq": 39000,
  "frequency_bands": [],
  "corner_compensation": true,
  "svd_threshold": 1,
  "svd_filter_mode": "number_of_values",
  "svd_remove_dc": true,
  "save_psd_avg": true,

  "square": true,
  "transpose": false,
  "flip_x": false,
  "flip_y": false,

  "debug" : false,
  "tictoc" : false,

  "debug_plot_parameters": {
    "spectrumloglog": {
      "ylim": [1e2, 1e5],
      "fit_f1" : 4000,
      "fit_f2" : 18000
    },
    "spectrum": {
      "ylim": [-1, 20],
      "use_stem" : false
    },
    "SVD_eigenvalues": {
      "ylim": [1,1e25],
      "log_plot" : true
    },
    "shifts" : {
      "scale": 30
    }
  }
}
